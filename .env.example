# Kopiera till .env.local och fyll i värdena från Firebase-konsolen
# (Projektinställningar → Dina appar → Webbapp → SDK-konfiguration).
# Utan dessa värden körs Leklandet i demoläge, där allt sparas lokalt på enheten.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
