# Bygget för testerna mot Firebase-emulatorn (npm run test:firebase).
# "demo-"-projekt finns bara i emulatorn och kräver ingen inloggning.
VITE_FIREBASE_API_KEY=demo-nyckel
VITE_FIREBASE_AUTH_DOMAIN=demo-larlabbet.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-larlabbet
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_EMULATOR=1
